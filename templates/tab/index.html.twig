{% extends 'template.html.twig' %}

{% block bodyTitle %}
    <h1>Array values are : </h1>
{% endblock %}
{% block body %}
    <table class="table">
        {% for key, value in array %}
            <tr>
                <td>array[{{ key }}]</td>
                <td>{{ value }}</td>
            </tr>
        {% endfor %}
    </table>
    <h4>Min = {{ min(array) }}</h4>
    <h4>Max = {{ max(array) }}</h4>
    <h4>Total = {{ array | length }}</h4>
{% endblock %}