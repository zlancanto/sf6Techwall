<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="{{ asset('node_modules/bootstrap/dist/css/bootstrap.css') }}">
    <title>users</title>
</head>
<body>
    <table class="table">
        <tr class="table-active">
            <th>Name</th>
            <th>Firstname</th>
            <th>Old</th>
        </tr>
        {% for user in users %}
            <tr class="table-{% if loop.index is odd %}danger
                            {% else %}warning{% endif %}">
                <td>{{ user.name }}</td>
                <td>{{ user.firstname }}</td>
                <td>{{ user.old }}</td>
            </tr>
        {% endfor %}
    </table>
</body>
</html>