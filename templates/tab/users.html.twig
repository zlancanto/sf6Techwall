{% extends 'template.html.twig' %}

{% block title %} Users {% endblock %}

{% block bodyTitle %} Users {% endblock %}

{% block body %}
    <table class="table">
        <tr class="table-active">
            <th>Name</th>
            <th>Firstname</th>
            <th>Old</th>
        </tr>
        {% for user in users %}
            <tr class="table-{% if loop.index is odd %}danger
                            {% else %}warning{% endif %}">
                <td>{{ user.name }}</td>
                <td>{{ user.firstname }}</td>
                <td>{{ user.old }}</td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}
