{% extends 'template.html.twig' %}

{% block title %} ToDo {% endblock %}

{% block bodyTitle %}
    <h1>Liste des todos : </h1>
{% endblock %}

{% block body %}
    <ol class="list-group">
        {% for key, value in app.session.get('todos') %}
            <li class="list-group-item">
                {{ key }} : {{ value }}
            </li>
        {% endfor %}
    </ol>
{% endblock %}