{% extends 'template.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ asset('node_modules/bootstrap/dist/css/bootstrap.css') }}
{% endblock %}

{% block title %}Person{% endblock %}

{% block bodyTitle %} Détails Person Id {% endblock %}

{% block body %}
    <div class="card w-50">
        <div class="card-body">
            <h5 class="card-title">{{ person.firstname }}</h5>
            <p class="card-text">My name is {{ person.name }} and i'm {{ person.old }} years</p>
            <a href="{{ path('app_person_delete', {id: person.id}) }}">
                <i class="bi bi-trash3-fill"></i>
            </a>
            {% if app.user %}
                <p>Created by : {{ app.user.username }}</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
