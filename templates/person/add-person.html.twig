{% extends 'template.html.twig' %}

{% block title %}Person{% endblock %}

{% block bodyTitle %} Create a new Person {% endblock %}

{% block body %}
    {{ form_start(formPerson) }}
    <div class="row">
        <div class="col-8">{{ form_row(formPerson.firstname) }}</div>
        <div class="col">{{ form_row(formPerson.name) }}</div>
    </div>
    {{ form_rest(formPerson) }}
{% endblock %}
