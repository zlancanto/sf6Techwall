{% extends 'template.html.twig' %}

{% block title %}Persons{% endblock %}

{% block bodyTitle %} Détails Persons {% endblock %}

{% block body %}
    <div class="table-responsive-xxl">
        <table class="table table-striped table-height-max">
            <tr>
                <th>Firstname</th>
                <th>Name</th>
                <th>Old</th>
            </tr>
            {% for person in persons %}
                <tr>
                    <td>{{ person.firstname }}</td>
                    <td>{{ person.name }}</td>
                    <td>{{ person.old }}</td>
                </tr>
            {% endfor %}
        </table>
    </div>
{% endblock %}
