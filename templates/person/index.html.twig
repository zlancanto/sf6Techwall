{% extends 'template.html.twig' %}

{% block title %}Persons{% endblock %}

{% block bodyTitle %} Détails Persons {% endblock %}

{% block body %}
    <div class="table-responsive-xxl">
        <table class="table table-striped table-height-max">
            <tr>
                <th>Firstname</th>
                <th>Name</th>
                <th>Old</th>
                <th>Détail</th>
            </tr>
            {% for person in persons %}
                <tr>
                    <td>{{ person.firstname }}</td>
                    <td>{{ person.name }}</td>
                    <td>{{ person.old }}</td>
                    <td>
                        <a href="{{ path('app_person_by_id',{id: person.id}) }}">
                            See more
                        </a>
                    </td>
                </tr>
            {% endfor %}
        </table>
    </div>
    {% if isPaginated %}
        <nav aria-label="...">
            <ul class="pagination">
                {% if page != 1 %}
                    <li class="page-item">
                        <a class="page-link" href="{{
                        path('app_person_by_criteria',
                            {page: page-1, number: number}
                        )
                        }}" tabindex="-1">
                            Previous
                        </a>
                    </li>
                {% endif %}
                {% for i in range(1, nombrePages) %}
                    <li class="page-item">
                        <a class="page-link" href="{{
                            path('app_person_by_criteria',
                                {page: i, number: number}
                            )
                        }}">
                            {{ i }}
                        </a>
                    </li>
                {% endfor %}
                {% if page != nombrePages %}
                    <li class="page-item">
                        <a class="page-link" href="{{
                        path('app_person_by_criteria',
                            {page: page+1, number: number}
                        )
                        }}">
                            Next
                        </a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    {% endif %}
{% endblock %}
